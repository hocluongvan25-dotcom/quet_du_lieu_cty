# Copy to .env.local and fill in:  cp .env.example .env.local
# The dashboard keeps working in demo mode while these values are empty.

# ---------------------------------------------------------------- Supabase ----
# Dashboard > Project Settings > API. Browser-safe: anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only privileged key (bypasses RLS). Never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------- Direct Postgres (pooler) ---
# Only for server jobs, seeds and migrations. Region is part of the host name.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ------------------------------------------------------ Scheduled retention ---
# Shared secret for POST /api/maintenance/retention (the pg_cron sweep and
# scripts/run-retention.mjs). Generate one with:  openssl rand -hex 32
# CRON_SECRET=

# ---------------------------------------------------- Research connectors -----
# Optional until a permitted source connector or model key is configured.
# RESEARCH_MODEL_API_KEY=

# ------------------------------------------------ Step 3: secondary sources ---
# The connector reads the company's own site first and only goes further when
# step 2 has not reached a buying door (procurement/purchasing/sourcing).
# Without these keys step 3 is simply skipped, and the run says why.
#
# Search API (Serper / Tavily / Brave). Queries are always scoped with
# `site:<company domain>`, and search results are only used to find URLs —
# the evidence is always the wording on a page we open ourselves.
# SEARCH_API_KEY=
# Khoá Tavily (tiền tố tvly-) được nhận ra tự động; đặt dòng dưới chỉ khi
# dùng Serper hoặc Brave.
# SEARCH_PROVIDER=serper

# SEC EDGAR (US) requires a User-Agent that identifies you WITH a contact —
# requests without one come back 403. Example value below; use your own.
# SEC_USER_AGENT=Your Name <you@example.com>

# UK Companies House officers/profile API. Free; the data is open under the
# Open Government Licence, which allows commercial reuse with attribution
# (the source label is always written). Registries have no email or phone.
# COMPANIES_HOUSE_API_KEY=

# ------------------------------------- Kiểm số có WhatsApp (Cloud API, tuỳ chọn) ---
# Kiểm một số có tài khoản WhatsApp trước khi mở nút wa.me. Không gửi tin nhắn
# nào — cả hai request chỉ là câu hỏi. Chưa điền thì nút wa.me nằm im, đúng như
# thiết kế: chưa kiểm thì chưa hiện. Các bước lấy: npm run whatsapp:check
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v26.0
